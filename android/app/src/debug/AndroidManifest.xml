<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: their own launcher name (they install next to the real app) and the
     demo data loader for the store screenshots (scripts/screenshots.sh). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:label="@string/debug_app_label"
        tools:replace="android:label">
        <receiver
            android:name=".DemoSeedReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver" />
    </application>
</manifest>
