<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. The AI keys never leave this phone: no cloud backup, no device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="ai_settings.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="ai_settings.xml" />
    </device-transfer>
</data-extraction-rules>
