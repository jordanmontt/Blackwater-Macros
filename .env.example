# Copy to .env.local (never committed) and fill in. Read by `npm run dev`, `db:push`, `db:check`,
# `create-user` and `set-admin`. The project shares one Neon database between local dev and
# production (docs/TECHNICAL.md §12): this is the production database.
# Neon → your project → Connect. Keep `?sslmode=require`; drop `&channel_binding=require`
# (the `postgres` driver sends it to the server, which refuses it).
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require
